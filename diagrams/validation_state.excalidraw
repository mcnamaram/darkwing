{
  "type": "excalidraw",
  "version": 2,
  "source": "hermes-agent",
  "elements": [
    // DarkWing validation state machine: raw CSV row → Pydantic → ObservationRecord
    { "type": "rectangle", "id": "r1_raw", "x": 30, "y": 140, "width": 160, "height": 70, "roundness": { "type": 3 }, "backgroundColor": "#d0bfff", "fillStyle": "solid", "boundElements": [{ "id": "t_r1", "type": "text" }, { "id": "a1", "type": "arrow" }] },
    { "type": "text", "id": "t_r1", "x": 50, "y": 150, "width": 120, "height": 50, "text": "Raw CSV Row\n(dict from csv.DictReader)", "fontSize": 16, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "r1", "originalText": "Raw CSV Row\n(dict from csv.DictReader)", "autoResize": true },

    { "type": "arrow", "id": "a1", "x": 190, "y": 175, "width": 100, "height": 0, "points": [[0,0],[100,0]], "endArrowhead": "arrow" },

    // Validate type coercion
    { "type": "rectangle", "id": "r2_coerce", "x": 300, "y": 130, "width": 160, "height": 70, "roundness": { "type": 3 }, "backgroundColor": "#ffd8a8", "fillStyle": "solid", "boundElements": [{ "id": "t_r2", "type": "text" }, { "id": "a2", "type": "arrow" }] },
    { "type": "text", "id": "t_r2", "x": 320, "y": 140, "width": 120, "height": 50, "text": "Type Coercion\n(str → int, str → list)", "fontSize": 16, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "r2", "originalText": "Type Coercion\n(str → int, str → list)", "autoResize": true },

    { "type": "arrow", "id": "a2", "x": 460, "y": 175, "width": 80, "height": 0, "points": [[0,0],[80,0]], "endArrowhead": "arrow" },

    // Validate domain rules
    { "type": "rectangle", "id": "r3_domain", "x": 550, "y": 130, "width": 160, "height": 70, "roundness": { "type": 3 }, "backgroundColor": "#ffd8a8", "fillStyle": "solid", "boundElements": [{ "id": "t_r3", "type": "text" }, { "id": "a3", "type": "arrow" }] },
    { "type": "text", "id": "t_r3", "x": 570, "y": 140, "width": 120, "height": 50, "text": "Domain Validators\n(minutes 0/20/40, code lookup)", "fontSize": 16, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "r3", "originalText": "Domain Validators\n(minutes 0/20/40, code lookup)", "autoResize": true },

    { "type": "arrow", "id": "a3", "x": 710, "y": 175, "width": 80, "height": 0, "points": [[0,0],[80,0]], "endArrowhead": "arrow" },

    // Output: validated record
    { "type": "rectangle", "id": "r4_ok", "x": 800, "y": 130, "width": 160, "height": 70, "roundness": { "type": 3 }, "backgroundColor": "#86efac", "fillStyle": "solid", "boundElements": [{ "id": "t_r4", "type": "text" }] },
    { "type": "text", "id": "t_r4", "x": 820, "y": 140, "width": 120, "height": 50, "text": "ObservationRecord\n(validated, ready to submit)", "fontSize": 16, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "r4", "originalText": "ObservationRecord\n(validated, ready to submit)", "autoResize": true },

    // Rejection paths
    { "type": "arrow", "id": "a_bad_type", "x": 380, "y": 200, "width": 0, "height": 60, "points": [[0,0],[0,60]], "endArrowhead": "arrow" },
    { "type": "rectangle", "id": "r5_badtype", "x": 300, "y": 280, "width": 160, "height": 70, "roundness": { "type": 3 }, "backgroundColor": "#ff8fab", "fillStyle": "solid", "boundElements": [{ "id": "t_r5", "type": "text" }] },
    { "type": "text", "id": "t_r5", "x": 320, "y": 290, "width": 120, "height": 50, "text": "ValidationError\n(unparseable type / missing field)", "fontSize": 16, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "r5", "originalText": "ValidationError\n(unparseable type / missing field)", "autoResize": true },

    { "type": "arrow", "id": "a_bad_domain", "x": 630, "y": 200, "width": 0, "height": 60, "points": [[0,0],[0,60]], "endArrowhead": "arrow" },
    { "type": "rectangle", "id": "r6_baddomain", "x": 550, "y": 280, "width": 160, "height": 70, "roundness": { "type": 3 }, "backgroundColor": "#ff8fab", "fillStyle": "solid", "boundElements": [{ "id": "t_r6", "type": "text" }] },
    { "type": "text", "id": "t_r6", "x": 570, "y": 290, "width": 120, "height": 50, "text": "ValidationError\n(minutes not 0/20/40, bad code)", "fontSize": 16, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "r6", "originalText": "ValidationError\n(minutes not 0/20/40, bad code)", "autoResize": true },

    // Legend
    { "type": "text", "id": "legend", "x": 30, "y": 400, "width": 500, "height": 40, "text": "Legend:  #d0bfff = input  #ffd8a8 = processing  #86efac = success  #ff8fab = error", "fontSize": 14, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "left", "verticalAlign": "top", "originalText": "Legend:  #d0bfff = input  #ffd8a8 = processing  #86efac = success  #ff8fab = error", "autoResize": true }
  ]
}
