{
  "type": "excalidraw",
  "version": 2,
  "source": "hermes-agent",
  "elements": [
    // DarkWing architecture flow: CSV → validate → translate → POST
    { "type": "rectangle", "id": "r1_csv", "x": 30, "y": 120, "width": 160, "height": 70, "roundness": { "type": 3 }, "backgroundColor": "#a5d8ff", "fillStyle": "solid", "boundElements": [{ "id": "t_r1", "type": "text" }, { "id": "a1", "type": "arrow" }] },
    { "type": "text", "id": "t_r1", "x": 50, "y": 130, "width": 120, "height": 50, "text": "Curated CSV\n(observation rows)", "fontSize": 16, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "r1", "originalText": "Curated CSV\n(observation rows)", "autoResize": true },

    { "type": "arrow", "id": "a1", "x": 190, "y": 155, "width": 80, "height": 0, "points": [[0,0],[80,0]], "endArrowhead": "arrow" },

    { "type": "rectangle", "id": "r2_io", "x": 280, "y": 110, "width": 160, "height": 70, "roundness": { "type": 3 }, "backgroundColor": "#ffd8a8", "fillStyle": "solid", "boundElements": [{ "id": "t_r2", "type": "text" }, { "id": "a2", "type": "arrow" }] },
    { "type": "text", "id": "t_r2", "x": 300, "y": 120, "width": 120, "height": 50, "text": "csv_io.read_csv()\n(parse flights, row check)", "fontSize": 16, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "r2", "originalText": "csv_io.read_csv()\n(parse flights, row check)", "autoResize": true },

    { "type": "arrow", "id": "a2", "x": 440, "y": 155, "width": 80, "height": 0, "points": [[0,0],[80,0]], "endArrowhead": "arrow" },

    { "type": "rectangle", "id": "r3_schema", "x": 530, "y": 110, "width": 160, "height": 70, "roundness": { "type": 3 }, "backgroundColor": "#ffd8a8", "fillStyle": "solid", "boundElements": [{ "id": "t_r3", "type": "text" }, { "id": "a3", "type": "arrow" }] },
    { "type": "text", "id": "t_r3", "x": 550, "y": 120, "width": 120, "height": 50, "text": "schema.ObservationRecord\n(minutes: 0/20/40, codes)", "fontSize": 16, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "r3", "originalText": "schema.ObservationRecord\n(minutes: 0/20/40, codes)", "autoResize": true },

    { "type": "arrow", "id": "a3", "x": 690, "y": 155, "width": 80, "height": 0, "points": [[0,0],[80,0]], "endArrowhead": "arrow" },

    { "type": "rectangle", "id": "r4_payload", "x": 780, "y": 110, "width": 160, "height": 70, "roundness": { "type": 3 }, "backgroundColor": "#a5d8ff", "fillStyle": "solid", "boundElements": [{ "id": "t_r4", "type": "text" }, { "id": "a4", "type": "arrow" }] },
    { "type": "text", "id": "t_r4", "x": 800, "y": 120, "width": 120, "height": 50, "text": "to_form_payload()\n(expand codes → long text)", "fontSize": 16, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "r4", "originalText": "to_form_payload()\n(expand codes → long text)", "autoResize": true },

    { "type": "arrow", "id": "a4", "x": 940, "y": 155, "width": 80, "height": 0, "points": [[0,0],[80,0]], "endArrowhead": "arrow" },

    { "type": "rectangle", "id": "r5_submit", "x": 1030, "y": 110, "width": 160, "height": 70, "roundness": { "type": 3 }, "backgroundColor": "#ffd8a8", "fillStyle": "solid", "boundElements": [{ "id": "t_r5", "type": "text" }, { "id": "a5", "type": "arrow" }] },
    { "type": "text", "id": "t_r5", "x": 1050, "y": 120, "width": 120, "height": 50, "text": "form_submit\n(gcloud token, POST)", "fontSize": 16, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "r5", "originalText": "form_submit\n(gcloud token, POST)", "autoResize": true },

    { "type": "arrow", "id": "a5", "x": 1190, "y": 155, "width": 100, "height": 0, "points": [[0,0],[100,0]], "endArrowhead": "arrow" },

    { "type": "rectangle", "id": "r6_apps", "x": 1300, "y": 80, "width": 160, "height": 70, "roundness": { "type": 3 }, "backgroundColor": "#a5d8ff", "fillStyle": "solid", "boundElements": [{ "id": "t_r6", "type": "text" }] },
    { "type": "text", "id": "t_r6", "x": 1320, "y": 90, "width": 120, "height": 50, "text": "Apps Script doPost\n(FormApp.createResponse)", "fontSize": 16, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "r6", "originalText": "Apps Script doPost\n(FormApp.createResponse)", "autoResize": true },

    // Down arrow from submit to log
    { "type": "arrow", "id": "a6", "x": 1110, "y": 180, "width": 0, "height": 60, "points": [[0,0],[0,60]], "endArrowhead": "arrow" },

    { "type": "rectangle", "id": "r7_log", "x": 1030, "y": 260, "width": 160, "height": 70, "roundness": { "type": 3 }, "backgroundColor": "#d0bfff", "fillStyle": "solid", "boundElements": [{ "id": "t_r7", "type": "text" }] },
    { "type": "text", "id": "t_r7", "x": 1050, "y": 270, "width": 120, "height": 50, "text": "submitted_log.jsonl\n(persistence between runs)", "fontSize": 16, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "r7", "originalText": "submitted_log.jsonl\n(persistence between runs)", "autoResize": true },

    // Rejection arrow
    { "type": "arrow", "id": "a_reject", "x": 610, "y": 180, "width": 0, "height": 60, "points": [[0,0],[0,60]], "endArrowhead": "arrow" },
    { "type": "rectangle", "id": "r8_fail", "x": 530, "y": 260, "width": 160, "height": 70, "roundness": { "type": 3 }, "backgroundColor": "#ff8fab", "fillStyle": "solid", "boundElements": [{ "id": "t_r8", "type": "text" }] },
    { "type": "text", "id": "t_r8", "x": 550, "y": 270, "width": 120, "height": 50, "text": "ValidationError\n(abort, report rows)", "fontSize": 16, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "r8", "originalText": "ValidationError\n(abort, report rows)", "autoResize": true }
  ]
}
