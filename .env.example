# Copy this file to .env and fill in real values.
# .env is gitignored — never commit it.

# DarkWing core configuration
DARKWING_FORM_URL="https://docs.google.com/forms/d/e/<form-id>/viewform"
DARKWING_SUBMITTER_EMAIL=[EMAIL_REDACTED]
DARKWING_SUBMITTER_NAME="Your Name"
DARKWING_DEFAULT_TOWER=3

# VLM (Vision Language Model) configuration - provider agnostic
# Set these to use any OpenAI-compatible VLM endpoint (Ollama, OpenRouter, vLLM, etc.)
VLM_BASE_URL="http://localhost:11434/v1"  # e.g., Ollama default
VLM_MODEL="swift-detector-v1"            # your model identifier
VLM_API_KEY="ollama"                     # for Ollama use "ollama"; for OpenRouter get API key
VLM_PROVIDER="ollama"                    # human-readable label for logs/errors

# Set to "false" to run Playwright visible (useful for debugging)
DARKWING_HEADLESS=true